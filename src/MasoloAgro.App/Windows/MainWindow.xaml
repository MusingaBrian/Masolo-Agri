<Window x:Class="MasoloAgro.App.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Masolo Agro Commodities Manager" Height="768" Width="1280">
    <Grid>
        <wv2:WebView2 x:Name="MainWebView" />
        <TextBlock x:Name="FallbackText"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="The application screen could not be loaded. Please restart the application." />
    </Grid>
</Window>
